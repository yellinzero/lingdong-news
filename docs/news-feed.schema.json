{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lingdong News Feed v1",
  "type": "object",
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "body",
          "publishedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "maxLength": 1000
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          },
          "publishedAt": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 1000000000000
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"
              }
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^(?:https?://|$)"
          },
          "tags": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "pattern": "^[^\\r\\n]+$"
            }
          },
          "dateEstimated": {
            "type": "boolean",
            "description": "缺少发布时间时由适配器按首次发现时间填写，后续同 ID 刷新不重置时间"
          }
        }
      }
    }
  }
}
