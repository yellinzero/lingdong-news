{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lingdong News source package v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sources"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "sources": {
      "type": "array",
      "maxItems": 203,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/package"
          },
          {
            "$ref": "#/$defs/legacy"
          }
        ]
      }
    }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "apiVersion",
        "entry",
        "network",
        "config"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(cls|wallstreet|jin10|custom:[a-zA-Z0-9_-]{1,73})$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 40
        },
        "apiVersion": {
          "const": 1
        },
        "entry": {
          "const": "adapter.js"
        },
        "network": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(https://[^/?#@*]+|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?)$",
            "description": "允许请求的域名，包含协议和端口，不带路径或结尾斜杠。"
          }
        },
        "config": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "header"
          ],
          "properties": {
            "origin": {
              "type": "string"
            },
            "header": {
              "enum": [
                "Authorization",
                "x-api-key"
              ]
            },
            "prefix": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[^\\r\\n]*$"
            }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "kind",
        "default"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_]{1,64}$",
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "enum": [
            "string",
            "number",
            "boolean"
          ]
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "string"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "script"
      ],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/manifest"
        },
        "script": {
          "type": "string",
          "minLength": 1,
          "description": "UTF-8 JavaScript，最多 256 KiB，定义 fetch(ctx)，不使用模块导入。"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "配置键须在 manifest.config 中声明，值须符合声明的类型。"
        }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^custom:[a-zA-Z0-9_-]{1,73}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "url": {
          "type": "string"
        },
        "format": {
          "enum": [
            "auto",
            "feed",
            "json",
            "adapter"
          ]
        },
        "auth": {
          "enum": [
            "none",
            "bearer"
          ]
        },
        "folder": {
          "type": "string",
          "maxLength": 128
        },
        "adapter": {
          "type": "object"
        }
      }
    }
  }
}
